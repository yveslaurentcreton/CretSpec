{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CretSpec project manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "code", "guidelines", "profile"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]*$" },
    "code": {
      "type": "object", "additionalProperties": false, "required": ["repository"],
      "properties": { "repository": { "type": "string", "minLength": 1 } }
    },
    "guidelines": {
      "type": "object", "additionalProperties": false, "required": ["repository", "ref"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "ref": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$", "description": "Branch for workingTree; selected version for pinned mode." },
        "mode": { "enum": ["workingTree", "pinned"], "description": "Omit to infer pinned when a lock exists, workingTree otherwise. Explicit modes require matching lock presence." }
      }
    },
    "profile": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
    "agents": {
      "type": "array", "uniqueItems": true,
      "items": { "enum": ["codex", "claude", "copilot", "cursor"] },
      "default": ["codex", "claude", "copilot", "cursor"],
      "description": "Local agent integrations. Omit for all supported integrations or use [] to disable them."
    }
  }
}
